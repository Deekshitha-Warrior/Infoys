{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --prefix careercast/frontend",
  "buildCommand": "npm run build --prefix careercast/frontend",
  "outputDirectory": "careercast/frontend/dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
